# Copy to config/domains.yml.
#
# scripts/render turns this into /srv/data/caddy/Caddyfile. Only entries with
# a non-empty value get a reverse-proxy route, so leaving a service blank is
# the supported way to keep it off the proxy — it can never break Caddy's
# startup the way an unset placeholder would.
#
# Use DNS names reachable only from your LAN/tailnet unless you deliberately
# want public access. MagicDNS names (*.ts.net) are the safe default.
domains:
  nextcloud: cloud.example.ts.net
  vaultwarden: vault.example.ts.net
  homeassistant: ha.example.ts.net
  lldap: ldap.example.ts.net
  adguard: dns.example.ts.net
  uptime: status.example.ts.net
  paperless: paperless.example.ts.net
  stirling: pdf.example.ts.net
  immich: photos.example.ts.net
  jellyfin: media.example.ts.net
  qbittorrent: torrents.example.ts.net
  prowlarr: prowlarr.example.ts.net
  radarr: radarr.example.ts.net
  sonarr: sonarr.example.ts.net
  calibre: books.example.ts.net
  odoo: odoo.example.ts.net
  forgejo: git.example.ts.net
