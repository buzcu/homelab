# Copy to config/secrets.env, fill in, then: chmod 600 config/secrets.env
#
# This file is consumed by scripts/render, which merges it with
# config/domains.yml and writes the Compose environment to
# /run/homelab/compose.env (tmpfs, root-only, regenerated on every deploy).
#
# DO NOT COMMIT config/secrets.env. It is listed in .gitignore.
#
# Generate strong values with:
#   openssl rand -base64 36

# --- Caddy -----------------------------------------------------------------
# The address registered with Let's Encrypt. Expiry warnings go there, so use
# a mailbox you actually read. Left empty, Caddy issues internal (self-signed)
# certificates only - fine for a tailnet, not for anything public.
ACME_EMAIL=

# Certificate authority. Leave empty for Let's Encrypt production.
#
# Use the staging directory for the FIRST public deployment: a wrong port
# forward otherwise burns the production rate limit for the name before
# anything works. Staging certificates are not trusted by browsers, which is
# expected - clear this again once the setup is verified.
#   CADDY_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
CADDY_ACME_CA=

# --- DuckDNS ---------------------------------------------------------------
# Only needed when publishing under a dynamic-DNS name. Also set
# duckdns_enabled: true in ansible/group_vars/all.yml to install the timer.
# The name may be given with or without the .duckdns.org suffix.
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# --- Nextcloud AIO ---------------------------------------------------------
# Address the AIO admin interface binds to. Keep it on loopback and reach it
# over an SSH tunnel, or set the host's Tailscale IP.
AIO_BIND_ADDRESS=127.0.0.1

# --- Vaultwarden -----------------------------------------------------------
# Must be the full external URL, e.g. https://vault.example.ts.net
VAULTWARDEN_URL=

# --- LLDAP -----------------------------------------------------------------
LLDAP_JWT_SECRET=
LLDAP_LDAP_USER_PASS=
LLDAP_LDAP_BASE_DN=dc=home,dc=arpa

# --- Mosquitto -------------------------------------------------------------
# scripts/render creates the Mosquitto password file from these.
MOSQUITTO_USERNAME=homelab
MOSQUITTO_PASSWORD=

# --- Zigbee2MQTT -----------------------------------------------------------
# Use a stable path, e.g. /dev/serial/by-id/usb-ITead_Sonoff_Zigbee-...
ZIGBEE_DEVICE=/dev/null

# --- AdGuard Home ----------------------------------------------------------
# The LAN address AdGuard binds :53 on. Must be a real address of this host.
ADGUARD_DNS_BIND=127.0.0.1

# --- Paperless -------------------------------------------------------------
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=

# --- Immich ----------------------------------------------------------------
IMMICH_DB_PASSWORD=
# Photo library. May live on the large disk.
IMMICH_UPLOAD_LOCATION=/srv/data/immich/library
# PostgreSQL data. MUST stay on local Unix-compatible storage.
IMMICH_DB_DATA_LOCATION=/srv/data/immich/postgres

# --- Odoo ------------------------------------------------------------------
ODOO_DB_PASSWORD=

# --- Forgejo ---------------------------------------------------------------
# Address Forgejo's SSH port binds to. 127.0.0.1 makes git-over-SSH
# unreachable from the tailnet; set the host's Tailscale IP to allow it.
FORGEJO_SSH_BIND=127.0.0.1

# --- Timezone --------------------------------------------------------------
TZ=Europe/Amsterdam
