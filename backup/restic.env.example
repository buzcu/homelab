# Copy to backup/restic.env, fill in, then: chmod 600 backup/restic.env
# DO NOT commit the real file. It is listed in .gitignore.
#
# When this file exists, scripts/backup replicates each nightly snapshot to
# the restic repository. Without it, snapshots stay on this host only — which
# is staging, not a backup.
#
# Initialise the repository once:  restic init

RESTIC_REPOSITORY=/mnt/backup/homelab
RESTIC_PASSWORD=CHANGE_ME

# Large paths that are NOT in the nightly snapshot (too big to re-archive
# every night) but should still be replicated. Space-separated.
BACKUP_EXTRA_PATHS="/srv/data/immich/library /srv/data/library /srv/data/paperless/media"

# For S3-compatible remote storage:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# RESTIC_REPOSITORY=s3:https://...
