homelab_timezone: Europe/Amsterdam
homelab_user: homelab

# Docker's storage location. Changing this after installation does NOT migrate
# existing images/containers; stop Docker and move /var/lib/docker yourself.
docker_data_root: /var/lib/docker

data_root: /srv/data
backup_root: /srv/backups

# Dedicated data disk:
# If you want Ansible to mount a dedicated disk, set these after formatting it.
# A non-existent device now fails the play instead of silently leaving all data
# on the system disk.
data_device: ""
data_mount: /srv/data
data_filesystem: ext4

# Set true only after confirming the SSH key works.
harden_ssh: false

# LAN CIDR used by the firewall. Adjust to your network.
lan_cidr: 192.168.1.0/24

# Tailscale interface.
tailscale_interface: tailscale0

# nftables ruleset (roles/firewall). Off by default: a wrong lan_cidr locks
# you out of SSH. Turn it on once Tailscale gives you a second way in.
# Recovery if you do lock yourself out: boot to console and run
#   nft delete table inet homelab
firewall_enabled: false

# Accept ports 80 and 443 from any source, not just lan_cidr. Required when
# services are published to the Internet through a dynamic-DNS name, and for
# Let's Encrypt's HTTP-01 challenge. SSH and DNS stay LAN-only either way.
# Only meaningful when firewall_enabled is true.
firewall_public_web: false

# DuckDNS updater (roles/systemd). Set true to install and enable
# homelab-duckdns.timer, which keeps a dynamic-DNS name pointed at this host
# every five minutes. The name and token go in config/secrets.env.
duckdns_enabled: false
