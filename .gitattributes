# Everything in this repository is consumed by Linux. A CRLF checkout turns
# every script into `bad interpreter: /bin/bash^M` and breaks systemd units and
# Compose files in less obvious ways, so line endings are pinned regardless of
# the machine the repository is edited on.
* text=auto eol=lf

# Files with no extension that are still shell scripts.
scripts/deploy      text eol=lf
scripts/backup      text eol=lf
scripts/healthcheck text eol=lf
scripts/render      text eol=lf
scripts/update-images text eol=lf
scripts/check-versions text eol=lf

*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.example   text eol=lf
Makefile    text eol=lf
