#!/usr/bin/env bash
set -euo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

usage() {
  cat <<EOF
Usage:
  sudo $0 [--force] [--no-render] <category|service|all>
  sudo $0 --help

Categories (from config/services.yml):
$(describe_categories)

Options:
  --force      Deploy even if config/services.yml marks the service disabled.
  --no-render  Skip scripts/render. Only use it when nothing in config/ changed.

Services disabled in config/services.yml are skipped, not deployed.
EOF
}

FORCE=false
RENDER=true
TARGET=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --force)     FORCE=true; shift ;;
    --no-render) RENDER=false; shift ;;
    -*) usage >&2; die "unknown option: $1" ;;
    *)
      [[ -z "$TARGET" ]] || { usage >&2; die "only one target may be given"; }
      TARGET="$1"; shift ;;
  esac
done

[[ -n "$TARGET" ]] || { usage >&2; exit 1; }

require_root
require_cmd docker

if [[ "$RENDER" == true ]]; then
  "$ROOT/scripts/render"
  echo
fi
require_compose_env

mapfile -t services < <(resolve_target "$TARGET")

# Validate everything before changing anything, so a typo in one Compose file
# cannot leave the stack half-deployed.
planned=()
for svc in "${services[@]}"; do
  compose="$ROOT/services/$svc/compose.yml"
  [[ -f "$compose" ]] || die "missing $compose"

  if [[ "$FORCE" != true && "$(service_enabled "$svc")" == "false" ]]; then
    log "Skipping $svc (disabled in config/services.yml; --force overrides)"
    continue
  fi

  log "Validating $svc"
  dc -f "$compose" config -q
  planned+=("$svc")
done

if [[ ${#planned[@]} -eq 0 ]]; then
  log "Nothing to deploy."
  exit 0
fi

echo
for svc in "${planned[@]}"; do
  compose="$ROOT/services/$svc/compose.yml"

  log "Pulling $svc"
  dc -f "$compose" pull

  log "Starting $svc"
  dc -f "$compose" up -d --remove-orphans

  log "Status $svc"
  dc -f "$compose" ps
  echo
done

log "Deployed: ${planned[*]}"
log "Verify with: sudo $ROOT/scripts/healthcheck"
