#!/usr/bin/env bash
# Enforce the repository's two "single source of truth" claims:
#   - every services/*/compose.yml image matches config/versions.yml
#   - every service directory has a config/services.yml entry, and vice versa
# Neither can be kept honest by convention alone, and both are the kind of
# drift that only shows up as a missing route or an unbacked-up database
# months later. Needs no Docker and no rendered environment, so CI can run it.
set -euo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

require_yaml

python3 - "$ROOT" <<'PY'
import pathlib, sys, yaml

root = pathlib.Path(sys.argv[1])
declared = (yaml.safe_load((root / "config/versions.yml").read_text()) or {}).get("images") or {}

actual = {}
for compose in sorted((root / "services").glob("*/compose.yml")):
    service_dir = compose.parent.name
    doc = yaml.safe_load(compose.read_text()) or {}
    for name, spec in (doc.get("services") or {}).items():
        image = (spec or {}).get("image")
        if image:
            actual[f"{service_dir}/{name}"] = image

problems = []
for key in sorted(set(declared) | set(actual)):
    want, have = declared.get(key), actual.get(key)
    if want is None:
        problems.append(f"  {key}: in a Compose file ({have}) but missing from config/versions.yml")
    elif have is None:
        problems.append(f"  {key}: in config/versions.yml ({want}) but no such Compose service")
    elif want != have:
        problems.append(f"  {key}: versions.yml says {want}, Compose says {have}")

    if have and ":" not in have.rsplit("/", 1)[-1]:
        problems.append(f"  {key}: image {have} has no tag")
    elif have and have.endswith(":latest") and key != "nextcloud-aio/nextcloud-aio-mastercontainer":
        problems.append(f"  {key}: uses :latest, which the repository forbids outside Nextcloud AIO")

if problems:
    print("config/versions.yml and services/*/compose.yml disagree:")
    print("\n".join(problems))
    sys.exit(1)

# The catalogue drives deploy categories, Caddy routes and backup scope, so a
# directory it does not list is invisible to all three at once.
catalogue = (yaml.safe_load((root / "config/services.yml").read_text()) or {}).get("services") or {}
dirs = {p.parent.name for p in (root / "services").glob("*/compose.yml")}

catalogue_problems = []
for name in sorted(dirs - set(catalogue)):
    catalogue_problems.append(
        f"  {name}: services/{name}/compose.yml exists but config/services.yml does not list it")
for name in sorted(set(catalogue) - dirs):
    catalogue_problems.append(
        f"  {name}: config/services.yml lists it but services/{name}/compose.yml is missing")
for name, spec in sorted(catalogue.items()):
    if not (spec or {}).get("category"):
        catalogue_problems.append(f"  {name}: no category, so no deploy target includes it")

if catalogue_problems:
    print("config/services.yml and services/ disagree:")
    print("\n".join(catalogue_problems))
    sys.exit(1)

services = len(dirs)
categories = len({(s or {}).get("category") for s in catalogue.values()})
print(f"Image pins consistent: {len(actual)} images across {services} services.")
print(f"Catalogue consistent: {services} services in {categories} categories.")
PY
