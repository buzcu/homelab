#!/usr/bin/env bash
# Generate every host-side artefact the Compose files depend on:
#   /run/homelab/compose.env                  Compose variable substitution
#   /srv/data/caddy/Caddyfile                 reverse-proxy routes
#   /srv/data/mosquitto/config/{mosquitto.conf,passwd}
#   /srv/data/zigbee2mqtt/configuration.yaml  (seeded once, never overwritten)
#   docker network "homelab"
#
# Idempotent. scripts/deploy runs this first; run it standalone after editing
# config/domains.yml or config/secrets.env.
set -euo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=lib/common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"

ENV_ONLY=false
for arg in "$@"; do
  case "$arg" in
    # Write only the Compose environment: no Docker, no root, no host files.
    # Used by CI to validate the Compose files.
    --env-only) ENV_ONLY=true ;;
    *) die "unknown argument: $arg" ;;
  esac
done

require_yaml
if [[ "$ENV_ONLY" != true ]]; then
  require_root
  require_cmd docker
fi

SECRETS="$ROOT/config/secrets.env"
DOMAINS="$ROOT/config/domains.yml"

[[ -f "$SECRETS" ]] || die "$SECRETS missing. Copy config/secrets.env.example and fill it in."
[[ -f "$DOMAINS" ]] || die "$DOMAINS missing. Copy config/domains.yml.example and fill it in."

# Refuse to leave a secrets file readable, or writable, by anyone but root.
# Mode alone is not enough: a file left owned by the invoking user is still
# theirs to read and to edit, whatever the permission bits say.
harden_secret_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0

  local owner mode
  owner="$(stat -c '%U:%G' "$file")"
  mode="$(stat -c '%a' "$file")"

  if [[ "$owner" != "root:root" ]]; then
    warn "$file is owned by $owner; changing to root:root"
    chown root:root "$file"
  fi
  if [[ "$mode" != "600" && "$mode" != "400" ]]; then
    warn "$file is mode $mode; tightening to 600"
    chmod 600 "$file"
  fi
}

if [[ "$ENV_ONLY" != true ]]; then
  harden_secret_file "$SECRETS"
  harden_secret_file "$ROOT/backup/restic.env"
fi

install -d -m 0700 "$RUNTIME_DIR"

# ---------------------------------------------------------------------------
# 1. Compose environment
# ---------------------------------------------------------------------------
log "Rendering $COMPOSE_ENV"

umask 077
python3 - "$SECRETS" "$DOMAINS" "$COMPOSE_ENV" <<'PY'
import re, sys, yaml

secrets_path, domains_path, out_path = sys.argv[1:4]

env = {}
line_re = re.compile(r'^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=(.*)$')
with open(secrets_path) as fh:
    for raw in fh:
        if not raw.strip() or raw.lstrip().startswith('#'):
            continue
        m = line_re.match(raw.rstrip('\n'))
        if not m:
            sys.exit(f"ERROR: cannot parse line in {secrets_path}: {raw.rstrip()}")
        key, value = m.group(1), m.group(2).strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        env[key] = value

with open(domains_path) as fh:
    domains = (yaml.safe_load(fh) or {}).get('domains') or {}
for name, domain in domains.items():
    env[f"{name.upper()}_DOMAIN"] = domain or ''

# Vaultwarden wants a full URL; derive it from the domain when unset.
if not env.get('VAULTWARDEN_URL') and env.get('VAULTWARDEN_DOMAIN'):
    env['VAULTWARDEN_URL'] = f"https://{env['VAULTWARDEN_DOMAIN']}"

env.setdefault('TZ', 'Europe/Amsterdam')

with open(out_path, 'w') as fh:
    fh.write("# Generated by scripts/render. Do not edit; edit config/secrets.env.\n")
    for key in sorted(env):
        fh.write(f"{key}={env[key]}\n")
PY
chmod 600 "$COMPOSE_ENV"

if [[ "$ENV_ONLY" == true ]]; then
  log "Wrote $COMPOSE_ENV (--env-only; skipping Docker, Caddy and service configs)."
  exit 0
fi

# Re-read the rendered values for the remaining steps.
set -a
# shellcheck disable=SC1090
source "$COMPOSE_ENV"
set +a

# ---------------------------------------------------------------------------
# 2. Shared Docker network
# ---------------------------------------------------------------------------
if ! docker network inspect "$HOMELAB_NETWORK" >/dev/null 2>&1; then
  log "Creating Docker network $HOMELAB_NETWORK"
  docker network create "$HOMELAB_NETWORK" >/dev/null
fi

# Read one image pin out of config/versions.yml.
pinned_image() {
  python3 -c '
import yaml, sys
print(yaml.safe_load(open(sys.argv[1]))["images"][sys.argv[2]])
' "$ROOT/config/versions.yml" "$1"
}

# ---------------------------------------------------------------------------
# 3. Caddyfile
# ---------------------------------------------------------------------------
log "Rendering /srv/data/caddy/Caddyfile"
install -d -m 0755 /srv/data/caddy

CADDYFILE=/srv/data/caddy/Caddyfile
CADDYFILE_NEW="$RUNTIME_DIR/Caddyfile.new"

python3 - "$SERVICES_FILE" "$DOMAINS" "$CADDYFILE_NEW" <<'PY'
import os, sys, yaml

services_path, domains_path, out_path = sys.argv[1:4]

# Routes come from the service catalogue joined to the host's hostnames.
# Adding a service to the proxy means a compose.yml port binding, an
# `upstream:` in config/services.yml and a hostname in config/domains.yml -
# this script is not edited.
with open(services_path) as fh:
    services = (yaml.safe_load(fh) or {}).get('services') or {}
with open(domains_path) as fh:
    domains = (yaml.safe_load(fh) or {}).get('domains') or {}

def spec_of(name):
    return services.get(name) or {}

# A hostname naming something that cannot be routed is almost always a typo or
# a key left over from an older layout. Silence there would look exactly like
# a working configuration that simply never answers.
for key, value in domains.items():
    if not (value or '').strip():
        continue
    spec = spec_of(key)
    if not spec:
        print(f"WARN: config/domains.yml has '{key}', which is not a service "
              f"in config/services.yml; no route generated", file=sys.stderr)
    elif not spec.get('upstream'):
        print(f"WARN: config/domains.yml has '{key}', which declares no "
              f"upstream in config/services.yml; no route generated",
              file=sys.stderr)
    elif not spec.get('enabled', True):
        print(f"WARN: '{key}' is disabled in config/services.yml; no route "
              f"generated (a route would answer 502)", file=sys.stderr)

out = [
    "# Generated by scripts/render. Do not edit by hand; edit config/domains.yml.",
    "# Only services with a non-empty domain get a route, so an unconfigured",
    "# service can never break Caddy's startup.",
    "",
]

email = os.environ.get('ACME_EMAIL', '').strip()
acme_ca = os.environ.get('CADDY_ACME_CA', '').strip()

if email or acme_ca:
    block = ["{"]
    if email:
        block.append(f"    email {email}")
    if acme_ca:
        # Pointing at a non-production directory is how a first public
        # deployment gets tested without spending the production rate limit
        # for the name on a misconfigured port forward.
        block.append(f"    acme_ca {acme_ca}")
    block.append("}")
    if acme_ca:
        block.insert(0, "# CADDY_ACME_CA is set: certificates come from a non-default CA.")
        block.insert(1, "# Browsers will not trust a staging certificate - that is expected.")
    out += block + [""]
else:
    out += [
        "# No ACME_EMAIL set: Caddy issues internal certificates only.",
        "# Set ACME_EMAIL in config/secrets.env to enable public ACME issuance.",
        "",
    ]

routed = 0
for name, spec in services.items():
    spec = spec or {}
    upstream = str(spec.get('upstream') or '').strip()
    domain = (domains.get(name) or '').strip()
    if not upstream or not domain or not spec.get('enabled', True):
        continue
    routed += 1
    out += [f"{domain} {{", f"    reverse_proxy {upstream}", "}", ""]

if not routed:
    out.append("# No domains configured in config/domains.yml.")

with open(out_path, 'w') as fh:
    fh.write("\n".join(out).rstrip() + "\n")
print(f"    {routed} route(s)")
PY

if [[ -f "$CADDYFILE" ]] && cmp -s "$CADDYFILE_NEW" "$CADDYFILE"; then
  log "    Caddyfile unchanged"
  rm -f "$CADDYFILE_NEW"
else
  caddy_image="$(pinned_image caddy/caddy)"

  # Validate before installing. An invalid Caddyfile takes every proxied
  # service down at once, so the running configuration stays until the new
  # one is known good.
  if ! docker run --rm -v "$CADDYFILE_NEW:/etc/caddy/Caddyfile:ro" "$caddy_image" \
       caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
    rm -f "$CADDYFILE_NEW"
    die "the generated Caddyfile is invalid; the running configuration was left in place"
  fi

  install -m 0644 "$CADDYFILE_NEW" "$CADDYFILE"
  rm -f "$CADDYFILE_NEW"

  # Compose compares service configuration, not the contents of a bind-mounted
  # file, so `deploy caddy` would report the container as already running and
  # never pick this up. Reload explicitly.
  caddy_cid="$(docker ps -q \
    --filter label=com.docker.compose.project=caddy \
    --filter label=com.docker.compose.service=caddy)"
  if [[ -z "$caddy_cid" ]]; then
    log "    Caddy is not running; the new routes apply when it next starts"
  elif docker exec "$caddy_cid" \
         caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
    log "    Caddy reloaded"
  else
    warn "Caddy is running but reload failed. It is still serving the previous routes."
    warn "Investigate with: docker logs $caddy_cid"
  fi
fi

# Loud on every run, not just the one that set it: a staging CA left in place
# serves certificates no browser trusts, and the symptom looks like a broken
# deployment rather than a leftover setting.
if [[ -n "${CADDY_ACME_CA:-}" ]]; then
  warn "CADDY_ACME_CA is set to ${CADDY_ACME_CA}"
  warn "Certificates are NOT from the production CA. Clear it in config/secrets.env once the setup is verified."
fi

# ---------------------------------------------------------------------------
# 4. Mosquitto configuration and credentials
# ---------------------------------------------------------------------------
# Gated on config/services.yml. Rendering unconditionally meant an operator who
# does not use MQTT could not deploy anything at all: render runs before every
# target and died here on an empty MOSQUITTO_PASSWORD.
if [[ "$(service_enabled mosquitto)" == "true" ]]; then
  log "Rendering Mosquitto configuration"
  install -d -m 0755 /srv/data/mosquitto/config /srv/data/mosquitto/data /srv/data/mosquitto/log
  install -m 0644 "$ROOT/services/mosquitto/config/mosquitto.conf" \
    /srv/data/mosquitto/config/mosquitto.conf

  if [[ -z "${MOSQUITTO_PASSWORD:-}" ]]; then
    die "MOSQUITTO_PASSWORD is empty in config/secrets.env, but mosquitto.conf sets allow_anonymous false. Every client would be rejected. Set it, or disable mosquitto in config/services.yml."
  fi

  # mosquitto_passwd hashes in place; run it in the same image the broker uses.
  docker run --rm \
    -v /srv/data/mosquitto/config:/mosquitto/config \
    "$(pinned_image mosquitto/mosquitto)" \
    mosquitto_passwd -b -c /mosquitto/config/passwd \
    "${MOSQUITTO_USERNAME:-homelab}" "$MOSQUITTO_PASSWORD" >/dev/null
  # The broker drops privileges to uid/gid 1883 and must be able to read this.
  chown 1883:1883 /srv/data/mosquitto/config/passwd
  chmod 600 /srv/data/mosquitto/config/passwd
else
  log "Skipping Mosquitto configuration (disabled in config/services.yml)"
fi

# ---------------------------------------------------------------------------
# 5. Zigbee2MQTT seed configuration
# ---------------------------------------------------------------------------
z2m_config=/srv/data/zigbee2mqtt/configuration.yaml
if [[ "$(service_enabled zigbee2mqtt)" != "true" ]]; then
  log "Skipping Zigbee2MQTT seed (disabled in config/services.yml)"
elif [[ -f "$z2m_config" ]]; then
  log "Zigbee2MQTT configuration exists; leaving it untouched"
else
  [[ -n "${MOSQUITTO_PASSWORD:-}" ]] \
    || die "zigbee2mqtt is enabled but MOSQUITTO_PASSWORD is empty; it could not reach the broker."
  install -d -m 0755 /srv/data/zigbee2mqtt
  log "Seeding $z2m_config"
  cat > "$z2m_config" <<EOF
# Seeded once by scripts/render. Zigbee2MQTT rewrites this file at runtime,
# so it is never regenerated. Edit it directly from here on.
homeassistant:
  enabled: true
frontend:
  enabled: true
  port: 8080
mqtt:
  base_topic: zigbee2mqtt
  server: mqtt://mosquitto:1883
  user: ${MOSQUITTO_USERNAME:-homelab}
  password: ${MOSQUITTO_PASSWORD}
serial:
  port: ${ZIGBEE_DEVICE}
advanced:
  log_level: info
EOF
  chmod 600 "$z2m_config"
fi

log "Render complete."
